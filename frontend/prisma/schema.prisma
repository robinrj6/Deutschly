generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  password      String
  words         Word[]
  dailySessions DailySession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
}

model Word {
  id               Int      @id @default(autoincrement())
  userId           Int?
  word             String
  article          String   @default("")
  plural           String   @default("")
  meaning          String   @default("")
  partOfSpeech     String   @default("")
  exampleSentences String[] @default([])
  tags             String[] @default([])
  seenInFlashcard  Boolean  @default(false)
  repetitionCount  Int      @default(0)
  intervalDays     Int      @default(0)
  easeFactor       Float    @default(2.5)
  nextReviewAt     DateTime?
  lastReviewedAt   DateTime?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([article])
  @@index([word])
  @@unique([userId, word])
}

model DailySession {
  id             Int      @id @default(autoincrement())
  userId         Int
  date           DateTime
  generatedCount Int      @default(0)
  completedCount Int      @default(0)
  completedAt    DateTime?
  wordsPayload   Json?
  exercisesPayload Json?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@unique([userId, date])
}
